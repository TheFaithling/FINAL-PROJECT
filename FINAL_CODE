label after_story_2:
    
    scene kitchen
    show Joey Sad at right 
    pause 1.0
    j "{w=1.5}...I'm gonna fast."
    j "He grabs his staff and makes his way out{w=0.5}."

    jump chapter_2

label chapter_2:

    scene black
    with fade

# MINIGAME 
# NOTICE: THIS MINIGAME HAS AN OVERLAPPING ISSUE. YOU MAY NEED TO RESTART THE MINIGAME IF SUCH HAPPENS

default sheep_found = 0
default found_pos = []
default daisy_pos = []
default special_pos = []

label game_part_1:
    $ import random
    $ sheep_found = 0
    $ daisy_pos = [(random.randint(0,1700), random.randint(0,800)) for _ in range(10)]
    $ special_pos = random.sample(daisy_pos, 3)
    $ found_pos = []

    j "Where are those sheep?"

    call screen sheep_game

    j "Finally! Let's go back to the barn!"
    jump chapter_3

screen sheep_game():

    tag game

    add "Daisy_Field.png"

    for pos in daisy_pos:

        if pos in special_pos:
            if pos in found_pos:
                add "sheep.png" xpos pos[0] ypos pos[1]
            else:
                imagebutton:
                    xpos pos[0] ypos pos[1]
                    idle "Daisy.png"
                    action SetVariable("sheep_found", sheep_found + 1), SetVariable("found_pos", found_pos + [pos]), Hide("sheep_game"), Show("sheep_game")
                    
        else:
            imagebutton:
                xpos pos[0] ypos pos[1]
                idle "Daisy.png"
                action NullAction()
    
    if sheep_found >= 3:
        timer 0.1 action Return()

label chapter_3:

    scene bg Valley
    with fade


    n "The pen gate is locked, and the little ones stick their head out the fense, grazing on them, lazily scanning Joey, who falls asleep laying on his staff."
    pause 3.0

    show Joey Guilty at right
    j "Eh-"
    hide Joey Guilty
    show Joey Shocked at right
    hide Joey Shocked
    pause 0.2
    scene bg Wolf
    n "{w=2.0}A wolf growls, the foam in his teeth shedding like molded cloth."
    n "It's not hungry. The darting of the eyes and snapping of the neck say it all. It's rabid."

    if after_food == "Eggs":
        jump Freeze
    elif after_food == "Sausage":
        jump Run
    elif after_food == "Toast":
        jump Sling

label Sling:

    pause 1.0

    j "{w=0.5}Lord... I'm no David. Guide the stone."
    n "Joey pulls out his sling, hands trembling."
    n "He winds it once...{w=0.5} twice...{w=0.5} again,"
    n "The stone sails through the air—{w=1.0}"

    pause 0.5

    n "And misses."


    jump continue_3

label Run:

    pause 1.0
    
    n "Joey's no good with the sling.{w=0.5}"
    n "He kicks up his heels and bolts for the ranch{w=0.5}"
    n "The wolf runs after him, lunging.{w=0.5}"
    n "Joey screams.{w=0.5}"

    jump continue_3

label Freeze:

    pause 1.0
    
    n "Joey can't move. {w=0.5}He prays. {w=0.5}Its all he can do.{w=0.5}"
    n "He stares the wolf down, {w=0.5}jaw clenched, {w=0.5}eyes burning with tears.{w=0.5}"

    jump continue_3

label continue_3:

