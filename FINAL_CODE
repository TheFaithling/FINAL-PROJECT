label after_story:

    pause 3.0

    scene kitchen
    show Joey Sad at right

    pause 1.5

    show Jenkin Angry at left:
        xzoom -1

    je "JOEY!"

    hide Joey Sad
    show Joey Shocked at right

    pause 1.0

    hide Joey Surprised
    show Joey Angry

    j "What?!"

    hide Jenkin Angry
    show Jenkin Neutral at left:
        xzoom -1

    je "Feed yourself or the sheep!"

    hide Jenkin Neutral

