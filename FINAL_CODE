label Dog_Name:
    $ Dog_Name = renpy.input("What should I name you?")
    
    if Dog_Name == "":
        $ Dog_Name = "Shepherd"

    show Joey Gentle at right
    show Shepherd Neutral at center

    j "[Dog_Name]."

    hide Joey Gentle
    show Joey Happy at right

    j "Ya like it? That's your new name!"

    hide Shepherd Neutral
    show Shepherd Calm

    scene black
    with fade

    hide Joey Happy
    hide Joey Gentle

    n "[Dog_Name] pushed his nose against Joey's, nuzzling him."

    scene bg Bond
    with fade

    n "And after many years, Joey laughed."

    scene black
    with fade

    pause 3.0

    jump chapter_4


label chapter_4:
